  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node validation/build/check-bundle-budget.mjs",
    "test": "vitest run",
    "p1:generate": "node validation/p1/generate-coupons.mjs && vite-node validation/p1/analyze-coupons.ts",
    "p1:prepare": "node validation/p1/pilot-cli.mjs prepare",
    "p1:record": "node validation/p1/pilot-cli.mjs record",
    "p1:verify": "node validation/p1/pilot-cli.mjs verify",
    "p1:summary": "node validation/p1/pilot-cli.mjs summary",
    "evidence:report": "vite-node validation/evidence/generate-report.ts",
    "evidence:import": "vite-node validation/evidence/import-external.ts",
    "interpretation:report": "vite-node validation/interpretation/evaluate-context-corpus.ts",
    "semantic:acceptance": "vite-node validation/semantic/run-v37-acceptance.ts",
    "semantic:providers": "vite-node validation/semantic/compare-providers.ts",
    "semantic:eval": "vite-node validation/semantic/evaluate-local-model.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "manifold-3d": "^3.5.1",
