{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check Make external evidence import mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "format", "scope", "factors", "outcomes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "format": { "enum": ["csv", "json", "jsonl"] },
    "idColumn": { "type": "string" },
    "scope": { "type": "object" },
    "factors": { "type": "array" },
    "outcomes": { "type": "array", "minItems": 1 }
  }
}

